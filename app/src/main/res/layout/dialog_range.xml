<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rangeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:clipToOutline="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtRangeTitle"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:paddingEnd="46dp"
                android:text="@string/range_title"
                android:textSize="19sp" />

            <FrameLayout
                android:id="@+id/btnRangeClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#FF1A2440"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dlg_cancel"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_dim" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnPrevMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#FF16203A"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/range_prev"
                    android:scaleX="-1"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="October 2026"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/btnNextMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#FF16203A"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/range_next"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_dim" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weekHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/rangeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtPicked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/range_none"
            android:textColor="@color/accent"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/range_help_title"
                android:textColor="@color/text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/stroke_soft" />

        <TextView
            android:id="@+id/txtRangeHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="@string/range_help"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnShowRange"
                style="@style/Widget.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/range_show"
                android:textSize="13.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClearRange"
                style="@style/Widget.GhostButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/range_clear"
                android:textSize="13.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelRange"
                style="@style/Widget.GhostButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/dlg_cancel"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
